{
  "name": "english-learning",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "shared",
    "api",
    "worker",
    "web-admin",
    "web-learner"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run test:db:up",
    "test": "npm run test --workspaces --if-present",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait db-test && docker compose -f docker-compose.test.yml run --rm --build migrate-test",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v",
    "seed": "docker compose --profile seed run --rm --build seed",
    "vocabulary:import": "node --import tsx scripts/import-vocabulary.ts",
    "vocabulary:audio:import": "node --import tsx scripts/import-vocabulary-audio.ts",
    "vocabulary:audio:generate": "node scripts/generate-wordbank-audio.mjs",
    "vocabulary:audio:test": "node --test scripts/generate-wordbank-audio.test.mjs",
    "scenario:package:check": "node scripts/check-scenario-package.mjs",
    "scenario:package:test": "node --test scripts/check-scenario-package.test.mjs",
    "scenario:preview:prepare": "node scripts/prepare-scenario-preview.mjs",
    "scenario:preview:test": "node --test scripts/prepare-scenario-preview.test.mjs",
    "build": "npm run build --workspaces --if-present",
    "migrate": "node-pg-migrate -m migrations",
    "migrate:up": "node-pg-migrate -m migrations up",
    "migrate:down": "node-pg-migrate -m migrations down"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.22.0"
  }
}
