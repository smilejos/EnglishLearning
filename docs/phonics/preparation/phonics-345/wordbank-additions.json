    {
      "id": 9219,
      "guid": "048e3d74-d5fe-51a1-85cd-079d1fd684ef",
      "level": {
        "cefr": null,
        "tw_7000": null,
        "list": null
      },
      "category": [],
      "scenario": [],
      "word": "oar",
      "parts_of_speech": [
        "n"
      ],
      "definition": "槳；用手划動小船的長柄工具，一端寬而扁平。",
      "explains": [
        {
          "guid": "3f037f6f-ffd8-5623-98f7-71587f3aa797",
          "en": "An oar is a long pole with a wide, flat end. A person pushes it through the water to move a small boat."
        },
        {
          "guid": "24fb9d80-7dba-5ae5-ad26-2cdd006f77bc",
          "en": "This noun names a tool used for rowing. A rower holds one end and puts the broad blade into the water."
        },
        {
          "guid": "3c2ee089-6aed-5381-99c6-57c38cdf06bb",
          "en": "An oar helps a person move or turn a boat by hand. It can be made of wood or another strong, light material."
        }
      ],
      "examples": [
        {
          "guid": "8c0b69bf-c824-5d8f-a907-650f81bdb9ea",
          "en": "The oar is in the boat.",
          "zh": "槳在船裡。"
        },
        {
          "guid": "3ba6c472-0b2d-5ad0-9acc-ca291342a5c4",
          "en": "He used an oar to move the boat.",
          "zh": "他用一支槳划動小船。"
        },
        {
          "guid": "754e3b53-938e-5e80-b716-a645fb9fb99c",
          "en": "She lifted the oar out of the water.",
          "zh": "她把槳從水裡提起。"
        },
        {
          "guid": "2b961a82-485f-5016-8002-7bacd90b13f6",
          "en": "The oar is on the shore.",
          "zh": "船槳在岸邊。"
        }
      ]
    },
