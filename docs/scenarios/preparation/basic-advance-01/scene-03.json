  "sentences": [
    {
      "en": "My family sits together at the table for dinner.",
      "zh": "我的家人一起坐在桌邊吃晚餐。"
    },
    {
      "en": "I am hungry after a long day at school.",
      "zh": "上了一整天的課，我肚子餓了。"
    },
    {
      "en": "There is rice on my plate and soup in my bowl.",
      "zh": "我的盤子裡有米飯，碗裡有湯。"
    },
    {
      "en": "I use a spoon to taste the soup first.",
      "zh": "我先用湯匙品嚐湯。"
    },
    {
      "en": "Then I take my fork and eat some chicken.",
      "zh": "接著我拿起叉子，吃一些雞肉。"
    },
    {
      "en": "We share the food and talk about our day.",
      "zh": "我們分享食物，聊聊今天的事。"
    },
    {
      "en": "My little brother asks for another small bowl of rice.",
      "zh": "弟弟想再吃一小碗米飯。"
    },
    {
      "en": "Soon I am full, so I put my spoon down.",
      "zh": "很快我吃飽了，所以放下湯匙。"
    },
    {
      "en": "Everyone is happy to spend this time together.",
      "zh": "大家都很開心能一起度過這段時間。"
    }
  ],
