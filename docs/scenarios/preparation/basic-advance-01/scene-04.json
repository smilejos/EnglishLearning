  "sentences": [
    {
      "en": "My bedroom is dirty after a busy week at school.",
      "zh": "在學校忙了一週後，我的臥室很髒。"
    },
    {
      "en": "I open the window and let the morning light in.",
      "zh": "我打開窗戶，讓晨光照進來。"
    },
    {
      "en": "A white pillow lies on the bed beside a blue blanket.",
      "zh": "床上有一個白色枕頭，旁邊是藍色毛毯。"
    },
    {
      "en": "I put my toy in the drawer near the closet.",
      "zh": "我把玩具放進衣櫥附近的抽屜。"
    },
    {
      "en": "Then I move the chair away from the window.",
      "zh": "接著我把椅子從窗邊移開。"
    },
    {
      "en": "My brother helps me clean the floor with water.",
      "zh": "哥哥幫我用水清理地板。"
    },
    {
      "en": "We also make the bed and pick up our clothes.",
      "zh": "我們也整理床鋪，撿起衣服。"
    },
    {
      "en": "The room is tidy, and there is space to play.",
      "zh": "房間整潔了，也有空間可以玩。"
    },
    {
      "en": "We sit down and enjoy the bright room together.",
      "zh": "我們一起坐下，享受明亮的房間。"
    }
  ],
