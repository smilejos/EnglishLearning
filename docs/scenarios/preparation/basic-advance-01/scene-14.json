  "sentences": [
    {
      "en": "We visit a shop to choose new clothes today.",
      "zh": "今天我們到商店挑選新衣服。"
    },
    {
      "en": "I wear a blue jacket and stand before the mirror.",
      "zh": "我穿著藍色夾克，站在鏡子前。"
    },
    {
      "en": "My mother holds a shirt beside me to compare.",
      "zh": "媽媽拿著一件襯衫站在我旁邊比較。"
    },
    {
      "en": "There is a long skirt beside a short skirt.",
      "zh": "一件長裙旁邊有一件短裙。"
    },
    {
      "en": "My sister finds a pretty dress and wants to try it.",
      "zh": "姐姐找到一件漂亮洋裝，想試穿。"
    },
    {
      "en": "She also looks at a hat near the door.",
      "zh": "她也看看門邊的一頂帽子。"
    },
    {
      "en": "I try each shoe and walk around to check the size.",
      "zh": "我試穿鞋子，走動一下確認尺寸。"
    },
    {
      "en": "We ask each other what we like before we buy.",
      "zh": "買之前，我們問彼此喜歡什麼。"
    },
    {
      "en": "Then we take our things home in a large bag.",
      "zh": "接著我們把東西裝進大袋子帶回家。"
    }
  ],
