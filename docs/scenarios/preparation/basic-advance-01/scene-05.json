  "sentences": [
    {
      "en": "It is a bright morning, and the sun is high.",
      "zh": "這是個明亮的早晨，太陽高掛。"
    },
    {
      "en": "We take our dirty clothes to the washing machine.",
      "zh": "我們把髒衣服拿到洗衣機旁。"
    },
    {
      "en": "I find a sock at the bottom of the basket.",
      "zh": "我在籃子底找到一隻襪子。"
    },
    {
      "en": "My mother helps me wash it with soap and water.",
      "zh": "媽媽幫我用肥皂和水洗它。"
    },
    {
      "en": "Then we hang a shirt on the line outside.",
      "zh": "接著我們把襯衫掛在外面的曬衣繩上。"
    },
    {
      "en": "The shirt is still wet, and water falls to the ground.",
      "zh": "襯衫還是濕的，水滴落到地上。"
    },
    {
      "en": "A dry towel is ready on the other side.",
      "zh": "另一邊有一條已經乾的毛巾。"
    },
    {
      "en": "I take it down and carry it into the house.",
      "zh": "我把它取下，拿進屋裡。"
    },
    {
      "en": "We finish our work before it is time for lunch.",
      "zh": "午餐時間前，我們完成了工作。"
    }
  ],
