  "sentences": [
    {
      "en": "Today we learn about water in our science class.",
      "zh": "今天我們在科學課學習水的知識。"
    },
    {
      "en": "There is a bottle of clear water on the table.",
      "zh": "桌上有一瓶清澈的水。"
    },
    {
      "en": "I use a ruler to measure how tall it is.",
      "zh": "我用尺測量瓶子有多高。"
    },
    {
      "en": "My friend puts blue water in a small cup.",
      "zh": "朋友把藍色的水放進一個小杯子。"
    },
    {
      "en": "We mix it with yellow water and watch the color change.",
      "zh": "我們把它和黃色的水混合，看著顏色改變。"
    },
    {
      "en": "A glass beside us is full, but another is empty.",
      "zh": "我們旁邊一個玻璃杯是滿的，另一個則是空的。"
    },
    {
      "en": "I am careful when I move the full glass.",
      "zh": "移動裝滿的玻璃杯時，我很小心。"
    },
    {
      "en": "Only a drop of water falls on the table.",
      "zh": "只有一滴水落在桌上。"
    },
    {
      "en": "We clean our place and tell the teacher what we see.",
      "zh": "我們清理座位，把看到的結果告訴老師。"
    }
  ],
