  "sentences": [
    {
      "en": "We are in the kitchen before school this morning.",
      "zh": "今天早上上學前，我們在廚房裡。"
    },
    {
      "en": "I help my father cook an egg in a pan.",
      "zh": "我幫爸爸用平底鍋煎一顆蛋。"
    },
    {
      "en": "The pan is hot, so I stand back and watch.",
      "zh": "平底鍋很熱，所以我退後站著觀看。"
    },
    {
      "en": "At the table, I use a knife to cut bread.",
      "zh": "我在桌邊用刀切麵包。"
    },
    {
      "en": "My father helps me put butter on the warm bread.",
      "zh": "爸爸幫我把奶油抹在溫熱的麵包上。"
    },
    {
      "en": "There is a full glass of milk beside my plate.",
      "zh": "我的盤子旁有一杯裝滿的牛奶。"
    },
    {
      "en": "We also have fresh juice for our breakfast today.",
      "zh": "今天早餐還有新鮮果汁。"
    },
    {
      "en": "I take a small bite and smile at my father.",
      "zh": "我咬了一小口，對爸爸微笑。"
    },
    {
      "en": "Our breakfast is ready, and we sit down together.",
      "zh": "早餐準備好了，我們一起坐下。"
    }
  ],
