  "sentences": [
    {
      "en": "My father and I find a table near the window.",
      "zh": "爸爸和我在窗邊找到一張桌子。"
    },
    {
      "en": "I sit on a chair while he looks at the menu.",
      "zh": "我坐在椅子上，他看著菜單。"
    },
    {
      "en": "He wants to order hot coffee and a sandwich.",
      "zh": "他想點熱咖啡和一份三明治。"
    },
    {
      "en": "I ask for a cold drink in a glass.",
      "zh": "我想要一杯裝在玻璃杯裡的冷飲。"
    },
    {
      "en": "The worker comes to serve our food and drinks.",
      "zh": "店員過來為我們送上食物和飲品。"
    },
    {
      "en": "She puts a cup of coffee in front of my father.",
      "zh": "她把一杯咖啡放在爸爸面前。"
    },
    {
      "en": "There is cream and sugar beside a little spoon.",
      "zh": "一支小湯匙旁有鮮奶油和糖。"
    },
    {
      "en": "We share the sandwich and talk about our morning.",
      "zh": "我們分享三明治，聊聊早上的事。"
    },
    {
      "en": "We are happy to enjoy this quiet time together.",
      "zh": "我們很開心能一起享受這段安靜的時光。"
    }
  ],
