# ---- Database ----
DATABASE_URL=postgres://app:app@db:5432/english_learning
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=english_learning

# ---- Audio storage (shared volume) ----
AUDIO_DIR=/data/audio
# 新產出音檔格式：m4a（AAC，體積約 wav 的 1/10）或 wav。既有音檔不受影響。
AUDIO_FORMAT=m4a

# ---- Google Gemini (server-side only; never exposed to the frontend) ----
# 共用文字、語音模型與聲線清單位於 config/generation-models.json；Compose 已掛載。
# 非 Compose 環境可用 GENERATION_MODELS_FILE 指向該 JSON，否則讀取專案預設路徑。
# Vertex AI 專案；使用 Google 供應商時必填。global 端點為 aiplatform.googleapis.com。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 使用 Vertex AI 授權用的 API key；若未設定，改用 ADC（例如已掛載的 service account）。
# Compose 不會自動掛載憑證檔，若自行掛載才設定其容器內路徑。
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/service-account.json
GEMINI_API_KEY=
# 生成模型與聲線改由後台「生成設定」管理；下列舊變數僅供相容舊程式。
GEMINI_TTS_MODEL=gemini-2.5-flash-tts
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
GEMINI_EXPLAIN_MODEL=gemini-2.5-flash
GEMINI_TTS_VOICE_EN=Kore
GEMINI_TTS_VOICE_ZH=Kore

# ---- Cloudflare Access (edge auth) ----
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# ---- Authorization ----
# Comma-separated allowlist of emails granted the admin role on login
# (app-level allowlist; everyone else is a reader). Case-insensitive.
ADMIN_EMAILS=

# ---- Local development ----
# When set to 1, the API bypasses Cloudflare Access verification and injects a
# dev identity. NEVER enable in production.
DEV_AUTH_BYPASS=1
DEV_USER_EMAIL=dev@example.com

# ---- Lookup 用量韁繩（快取未命中才計數）----
# 每位使用者每分鐘可觸發的 LLM 查詢數 / 全站每日上限
LOOKUP_USER_PER_MIN=10
LOOKUP_GLOBAL_PER_DAY=200

# ---- Worker 佇列 ----
# 輪詢間隔、單一 job 的重試上限、processing 多久視為崩潰並回收。
WORKER_POLL_MS=3000
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_MS=300000
# 重試退避：第 n 次失敗後等 BASE_SEC × 2^(n-1) 秒才再試，上限 MAX_SEC。
# 沒有退避的話，失敗的 job 會在同一輪迴圈被立刻重撿，數秒內燒完所有 attempts，
# 使 429／暫時性網路錯誤根本來不及恢復就被判終態失敗。
WORKER_BACKOFF_BASE_SEC=30
WORKER_BACKOFF_MAX_SEC=900

# ---- Ports (host side) ----
API_PORT=8080
WEB_ADMIN_PORT=8081
WEB_LEARNER_PORT=8082

# 前後台互連對外網址（build 時注入 SPA；正式環境填你的網域）
# admin 頁的「前台」連結用 LEARNER_URL_PUBLIC；learner 頁的「後台」連結用 ADMIN_URL_PUBLIC。
# 可只填網域（SPA 會自動補 https://）；本機開發保留 http://localhost。
# 對外採單一網域＋路徑分流（後台在 /admin，經 proxy 服務），正式機範例：
#   LEARNER_URL_PUBLIC=e-learning.jos.homes
#   ADMIN_URL_PUBLIC=e-learning.jos.homes/admin
LEARNER_URL_PUBLIC=http://localhost:8090
ADMIN_URL_PUBLIC=http://localhost:8090/admin

# 單一入口 proxy 對本機曝露的埠（Cloudflare Tunnel 則直接指 http://proxy:80）
PROXY_PORT=8090

# ---- Cloudflare Tunnel（對外單一入口；--profile tunnel 才啟用）----
# 於 Cloudflare Zero Trust → Networks → Tunnels 建立後取得的 Token（敏感值，勿提交）。
# 詳見 docs/sop-cloudflare-tunnel-single-ingress-2026-07-05.md。
CLOUDFLARE_TUNNEL_TOKEN=
# OpenAI 憑證供 API、文章 worker 與圖片 worker 使用；不會因設定憑證自動產生內容。
# deploy.sh includes image-worker by default; start only it with: ./scripts/deploy.sh up image-worker
OPENAI_API_KEY=
# OPENAI_API_KEY_FILE 目前僅供 image-worker 使用；API 與文章 worker 請設定 OPENAI_API_KEY。
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# IMAGE_DIR=/data/images
# IMAGE_MODELS_FILE=/app/config/image-models.json
# IMAGE_PRICING_FILE=/app/config/image-pricing.json

# ---- 情境製作（獨立 --profile scenarios；只在按下生成後排入工作）----
# API 和 scenario-worker 共用可寫草稿媒體目錄；已發布圖片仍由 API 唯讀掛載。
# SCENARIO_STUDIO_DIR=/data/scenario-studio
# 本機 Node 開發改成 http://127.0.0.1:8000/v1/audio/speech。
# 只連接既有 Qwen3-TTS 服務，不會自動啟動錄音服務或下載模型。
SCENARIO_QWEN_TTS_URL=http://host.docker.internal:8000/v1/audio/speech
